# --- Database (PostgreSQL). Any managed Postgres works (Supabase, Neon, RDS, Cloud SQL).
# DATABASE_URL=postgresql://localhost/proof_of_repair
# DB_BACKEND=sqlite            # force the SQLite fallback

# --- Ethereum Sepolia public testnet (test ETH only; never put real funds here)
# Free test ETH: https://cloud.google.com/application/web3/faucet/ethereum/sepolia
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# DEPLOYER_PRIVATE_KEY=0xYOUR_TEST_WALLET_KEY
# DEPLOYER_ADDRESS=0xYOUR_TEST_WALLET_ADDRESS
# CHAIN_CONFIG=artifacts/chain_config.sepolia.json   # which deployed contract the API uses
# ETHERSCAN_API_KEY=YOUR_KEY   # free at etherscan.io/myapikey; used by scripts/verify_etherscan.py

# Local Hardhat defaults are written to artifacts/chain_config.hardhat-local.json by
# scripts/start_demo.sh. No .env is needed for localhost.

# --- OpenTimestamps: live (default) | sim | auto
# OTS_MODE=live
# OTS_CALENDARS=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org
